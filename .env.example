# MySQL (Hostinger, atau lokal/dev sebelum ada hosting aktif)
DATABASE_URL="mysql://user:password@localhost:3306/tka_cpns"

# Better Auth
BETTER_AUTH_SECRET="ganti-dengan-secret-acak-panjang"
BETTER_AUTH_URL="http://localhost:3000"

# URL publik situs (untuk metadata SEO, sitemap, robots.txt)
SITE_URL="http://localhost:3000"
# Kode verifikasi Google Search Console (tag HTML, isi content saja). Opsional.
# GOOGLE_SITE_VERIFICATION=""

# Enkripsi Gemini API key milik user (AES-256-GCM) — bukan API key Gemini itu sendiri
ENCRYPTION_SECRET="ganti-dengan-secret-acak-32-byte"

# Opsional: model Gemini untuk generate soal (default gemini-3-flash-preview).
# API key Gemini TIDAK di sini — disimpan per user lewat halaman Pengaturan.
# GEMINI_MODEL="gemini-3-flash-preview"

# Penyedia pembayaran: "xendit", "midtrans", atau "doku". Kosong → Xendit bila
# XENDIT_SECRET_KEY terisi, lalu Midtrans bila MIDTRANS_SERVER_KEY terisi, selain itu DOKU.
# PAYMENT_PROVIDER="xendit"
# Mode Sandbox: hanya admin + email di sini (dipisah koma) yang bisa membayar.
# PAYMENT_TEST_EMAILS="siswa.uji@contoh.com"

# Xendit Invoice. Secret Key dari Dashboard Xendit → Settings → API Keys (izin Write
# untuk Money-in/Invoices). Test: "xnd_development_…", Live: "xnd_production_…" — mode
# mengikuti key. Verification Token: Settings → Webhooks (beda untuk Test & Live).
# URL webhook (Invoices paid): https://<domain>/api/xendit/notification
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""
# Opsional, kode dipisah koma (mis. "QRIS,BCA,BNI,BRI,MANDIRI,OVO,DANA,SHOPEEPAY"); kosong = semua metode aktif.
# XENDIT_PAYMENT_METHODS=""

# Midtrans Snap. Server Key dari Dashboard Midtrans → Pengaturan → Akses Key
# (Sandbox: "SB-Mid-server-…"; Production: "Mid-server-…"). URL notifikasi:
# https://<domain>/api/midtrans/notification
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"
# Opsional, kode dipisah koma (mis. "other_qris,gopay,bca_va"); kosong = semua metode aktif.
# MIDTRANS_ENABLED_PAYMENTS=""

# Pembayaran DOKU Checkout (QRIS). Client ID & Secret Key dari DOKU Back Office →
# Integration → API Keys. Mulai dengan akun Sandbox, lalu ganti ke Production.
DOKU_CLIENT_ID=""
DOKU_SECRET_KEY=""
DOKU_IS_PRODUCTION="false"
# Metode di halaman bayar DOKU: kode dipisah koma (default QRIS), atau ALL = semua channel aktif.
# DOKU_PAYMENT_METHODS="QRIS"

# Login/daftar dengan Google (opsional — tombol Google hanya muncul bila keduanya diisi).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email kontak yang tampil di halaman /privasi dan /syarat (opsional).
# CONTACT_EMAIL="halo@domainanda.com"

# SMTP untuk "Lupa kata sandi" (WORKFLOW §10). Kosong = fitur reset email nonaktif
# (halaman /lupa-kata-sandi mengarahkan ke admin).
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_USER="noreply@domainanda.com"
# SMTP_PASS="kata-sandi-akun-email"
# EMAIL_FROM="Pakar TKA <noreply@domainanda.com>"

# Backup database otomatis (WORKFLOW §14). CRON_SECRET acak ≥ 24 karakter: `openssl rand -hex 32`.
# CRON_SECRET=""
# BACKUP_DIR=""        # default ~/backups/pakartka (di luar folder web)
# BACKUP_KEEP="14"     # jumlah file terbaru yang disimpan
# BACKUP_EMAIL_TO=""   # salinan via email (butuh SMTP); dipakai bila cron memakai ?email=1

